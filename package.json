    "@types/node": "^24.13.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-pivottable": "^0.11.6",
    "@vitejs/plugin-react": "^6.0.3",
