{
  "name": "vote",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev src/worker/dev-entry.ts --config wrangler.pages-dev.toml --port 8787",
    "dev:full": "concurrently -n vite,worker -c blue,green \"npm run dev\" \"npm run dev:worker\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "verify:api": "node scripts/verify-api.mjs",
    "verify:security": "node scripts/verify-rest-security.mjs",
    "verify:import": "node scripts/verify-import.mjs",
    "deploy:pages": "npx wrangler pages deploy dist --project-name voterdata-management"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.4.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.7.4",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "hono": "^4.13.7",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "kysely": "^0.29.5",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.23.0",
    "papaparse": "^5.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-pivottable": "^0.11.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^3.9.2",
